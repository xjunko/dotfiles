def gtk_named_colors(p: dict[str, str]) -> dict[str, str]:
    bg, bg_alt, bg_hi = p["bg"], p["bg_alt"], p["bg_hi"]
    fg, fg_dim = p["fg"], p["fg_dim"]
    accent, accent_fg = p["accent"], p["accent_fg"]
    accent_dim, accent_soft = p["accent_dim"], p["accent_soft"]
    border, border_soft = p["border"], p["border_soft"]
    button, button_alt = p["button"], p["button_alt"]
    error, warning, success = p["error"], p["warning"], p["success"]
    link, link_visited = p["link"], p["link_visited"]
    titlebar, tooltip_bg = p["titlebar"], p["tooltip_bg"]
    dim = lambda c: mix(c, bg, 0.5)  # noqa: E731

