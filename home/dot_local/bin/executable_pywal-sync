def adwaita_colors(p: dict[str, str]) -> dict[str, str]:
    bg, bg_alt, fg = p["bg"], p["bg_alt"], p["fg"]
    accent, accent_fg = p["accent"], p["accent_fg"]
    error, warning, success = p["error"], p["warning"], p["success"]
    titlebar = p["titlebar"]
    return {
        "accent_color": accent,
        "accent_bg_color": accent,
        "accent_fg_color": accent_fg,
        "destructive_color": error,
        "destructive_bg_color": error,
        "destructive_fg_color": readable_on(error, bg),
        "success_color": success,
        "success_bg_color": success,
        "success_fg_color": readable_on(success, bg),
        "warning_color": warning,
        "warning_bg_color": warning,
        "warning_fg_color": readable_on(warning, bg),
        "error_color": error,
        "error_bg_color": error,
        "error_fg_color": readable_on(error, bg),
        "window_bg_color": bg,
        "window_fg_color": fg,
        "view_bg_color": bg,
        "view_fg_color": fg,
        "headerbar_bg_color": titlebar,
        "headerbar_fg_color": fg,
        "headerbar_border_color": p["border"],
        "headerbar_backdrop_color": bg,
        "headerbar_shade_color": "rgba(0, 0, 0, 0.2)",
        "card_bg_color": bg_alt,
        "card_fg_color": fg,
        "card_shade_color": "rgba(0, 0, 0, 0.2)",
        "dialog_bg_color": bg_alt,
        "dialog_fg_color": fg,
        "popover_bg_color": bg_alt,
        "popover_fg_color": fg,
        "popover_shade_color": "rgba(0, 0, 0, 0.2)",
        "sidebar_bg_color": bg_alt,
        "sidebar_fg_color": fg,
        "sidebar_backdrop_color": bg,
        "sidebar_shade_color": "rgba(0, 0, 0, 0.2)",
        "secondary_sidebar_bg_color": bg,
        "secondary_sidebar_fg_color": fg,
        "thumbnail_bg_color": bg_alt,
        "thumbnail_fg_color": fg,
        "shade_color": "rgba(0, 0, 0, 0.2)",
        "scrollbar_outline_color": "rgba(0, 0, 0, 0.5)",
    }


def css_block(colors: dict[str, str], header: str) -> str:
    lines = [f"/* {header} - generated by pywal-sync */"]
    for name, value in colors.items():
        lines.append(f"@define-color {name} {value};")
    return "\n".join(lines) + "\n"


def ensure_gtk_assets() -> None:
    """The copied Breeze GTK4 CSS references ../assets; keep that resolvable."""
    assets = CONFIG_HOME / "assets"
    target = Path("/usr/share/themes/Breeze-Dark/assets")
    if target.exists() and not assets.exists() and not assets.is_symlink():
        assets.symlink_to(target)


def write_gtk3(p: dict[str, str]) -> None:
    GTK3_DIR.mkdir(parents=True, exist_ok=True)
    GTK3_CSS.write_text(css_block(gtk_named_colors(p), "GTK3 colors"))


def write_gtk4(p: dict[str, str]) -> None:
    GTK4_DIR.mkdir(parents=True, exist_ok=True)
    ensure_gtk_assets()
    named = gtk_named_colors(p)
    extra = css_block(adwaita_colors(p), "libadwaita colors")

    if BREEZE_GTK4.exists():
        base = BREEZE_GTK4.read_text()

        def repl(match: re.Match[str]) -> str:
            name = match.group(1)
            if name in named:
                return f"@define-color {name} {named[name]};"
            return match.group(0)

        content = re.sub(r"@define-color\s+([A-Za-z0-9_]+)\s+[^;]+;", repl, base) + "\n" + extra
    else:
        content = css_block(named, "GTK4 colors") + "\n" + extra

    if GTK4_CSS.is_symlink() or GTK4_CSS.exists():
        GTK4_CSS.unlink()
    GTK4_CSS.write_text(content)


def update_gtk_settings() -> None:
    for path in (GTK3_DIR / "settings.ini", GTK4_DIR / "settings.ini"):
        values = {"gtk-icon-theme-name": ICON_THEME_NAME}
        if not path.exists():
            values.update(
                {
                    "gtk-theme-name": "Breeze-Dark",
                    "gtk-application-prefer-dark-theme": "1",
                }
            )
        set_ini_keys(path, "Settings", values)

    gsettings = shutil.which("gsettings")
    if gsettings:
        subprocess.run(
            [gsettings, "set", "org.gnome.desktop.interface", "icon-theme", ICON_THEME_NAME],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )

    if XSETTINGSD.exists():
        text = XSETTINGSD.read_text()
        text = re.sub(r'^Net/IconThemeName\s+".*"', f'Net/IconThemeName "{ICON_THEME_NAME}"', text, flags=re.M)
        XSETTINGSD.write_text(text)


# --------------------------------------------------------------------------
# Breeze icon accent (GTK/Qt don't apply KDE's accent substitution)
# --------------------------------------------------------------------------

ACCENT_RE = re.compile(r"(\.ColorScheme-Accent\s*\{\s*color:\s*)#[0-9a-fA-F]{6}")
TEXT_RE = re.compile(r"(\.ColorScheme-Text\s*\{\s*color:\s*)#[0-9a-fA-F]{6}")


def build_icon_theme(p: dict[str, str], verbose: bool = False) -> bool:
    accent, fg = p["accent"], p["fg"]
    try:
        src_mtime = (ICON_SRC / "index.theme").stat().st_mtime_ns
    except OSError:
        return False

    key = f"{accent}|{fg}|{src_mtime}"
    if ICON_DST.exists() and ICON_STAMP.exists() and ICON_STAMP.read_text().strip() == key:
        return False

    if verbose:
        print(f"  rebuilding {ICON_DST.name}")

    if ICON_DST.exists():
        shutil.rmtree(ICON_DST)
    ICON_DST.mkdir(parents=True)

    index = (ICON_SRC / "index.theme").read_text()
    index = re.sub(r"^Name=.*$", "Name=Breeze Dark (Pywal)", index, count=1, flags=re.M)
    index = re.sub(r"^Inherits=.*$", f"Inherits={KDE_ICON_THEME}", index, count=1, flags=re.M)
    if re.search(r"^FollowsColorScheme=", index, flags=re.M):
        index = re.sub(r"^FollowsColorScheme=.*$", "FollowsColorScheme=false", index, flags=re.M)
    else:
        index += "\nFollowsColorScheme=false\n"
    (ICON_DST / "index.theme").write_text(index)

    dirs = set()
    match = re.search(r"^Directories=(.*)$", index, flags=re.M)
    if match:
        dirs.update(d.strip() for d in match.group(1).split(",") if d.strip())
    for d in dirs:
        (ICON_DST / d).mkdir(parents=True, exist_ok=True)

    written = 0
    # Icon names that have an accent-colored variant in at least one size.
    # Their other sizes are copied too so GTK doesn't fall back to a larger,
    # differently designed icon when a small size is requested.
    accent_names: set[str] = set()
    for svg in ICON_SRC.rglob("*.svg"):
        try:
            if "ColorScheme-Accent" in svg.read_text(errors="ignore"):
                accent_names.add(svg.name)
        except OSError:
            continue

    for svg in ICON_SRC.rglob("*.svg"):
        if svg.name not in accent_names:
            continue
        try:
            data = svg.read_text(errors="ignore")
        except OSError:
            continue

        has_accent = "ColorScheme-Accent" in data
        has_text = "ColorScheme-Text" in data
        if not (has_accent or has_text):
            continue

        if has_accent:
            data = ACCENT_RE.sub(lambda m: m.group(1) + accent, data)
        if has_text:
            data = TEXT_RE.sub(lambda m: m.group(1) + fg, data)
            data = re.sub(r"#fcfcfc", fg, data, flags=re.I)

        out = ICON_DST / svg.relative_to(ICON_SRC)
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(data)
        written += 1

    updater = shutil.which("gtk-update-icon-cache")
    if updater:
        subprocess.run(
            [updater, "-f", "-t", str(ICON_DST)],
            check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )

    ICON_STAMP.parent.mkdir(parents=True, exist_ok=True)
    ICON_STAMP.write_text(key)
    if verbose:
        print(f"  patched {written} icons")
    return True


# --------------------------------------------------------------------------
# misc
# --------------------------------------------------------------------------

def update_hyprqt6() -> None:
    if not HYPRQT6.exists():
        return
    text = HYPRQT6.read_text()
    new = re.sub(r"^(\s*icon_theme\s*=\s*).*$", rf"\g<1>{ICON_THEME_NAME}", text, flags=re.M)
    if new != text:
        HYPRQT6.write_text(new)


def update_app_schemes() -> None:
    """KDE apps can pin their own color scheme; point them at the pywal one."""
    for name in ("dolphinrc",):
        path = CONFIG_HOME / name
        if not path.exists():
            continue
        text = path.read_text()
        new = re.sub(r"^ColorScheme=.*$", f"ColorScheme={SCHEME_NAME}", text, flags=re.M)
        if new != text:
            path.write_text(new)


def main() -> int:
    parser = argparse.ArgumentParser(description="Sync desktop colors with pywal")
    parser.add_argument("--accent", help="color0..color15 or #rrggbb (overrides config)")
    parser.add_argument("--skip-icons", action="store_true", help="do not rebuild the Breeze icon theme")
    parser.add_argument("--verbose", action="store_true")
    args = parser.parse_args()

    colors, bg, fg = load_wal()
    accent = args.accent or load_accent(colors, bg)
    if not accent.startswith("#"):
        accent = colors.get(accent, load_accent(colors, bg))
    palette = build_palette(colors, bg, fg, accent)

    if args.verbose:
        print(f"pywal-sync: bg={bg} fg={fg} accent={accent}")

    write_kde_scheme(palette, kde_effects())
    merge_kdeglobals(palette)
    update_app_schemes()

    write_qt_colors(QT5_COLORS, palette, QT5_ORDER)
    write_qt_colors(QT6_COLORS, palette, QT_ORDER)
    configure_qt()

    write_gtk3(palette)
    write_gtk4(palette)
    update_gtk_settings()
    update_hyprqt6()

    if not args.skip_icons:
        build_icon_theme(palette, verbose=args.verbose)

    print(f"pywal-sync: colors updated (accent {accent})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
