{
    "modules-right": [
        "tray",
        "custom/separator",
        "group/cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "clock"
    ],
    "temperature#cpu": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "format": " ({temperatureC}°C)",
        "critical-threshold": 85
    },
    "temperature#gpu": {
        "format": "{}",
        "rewrite": {
            "": "void"
        }
    },
    "custom/gpu": {
        "format": "{}",
        "rewrite": {
            "": "void"
        }
    }
}
