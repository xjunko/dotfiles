// It is generally better to configure device-specific settings,
// such as network interfaces,
// in a separate "specific.jsonc" file, which allows the configuration
// to be portable between different machines with minimal effort.
// Following is an example of device-specific configuration:
//
// {
//     "network": {
//         "interface": "eno1"
//     }
// }
//
// The "specific.jsonc" file must be placed inside of this directory
// to be detected. The following line can be edited
// to change the path (or name) of the file.
{
    "include": [
        "./specific.jsonc"
    ],
    "custom/separator": {
        "format": "<span color='#808080'><b> | </b></span>"
    },
    "layer": "bottom",
    "height": 25,
    "spacing": 0,
    "position": "top",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "tray",
        "custom/separator",
        "battery",
        "custom/separator",
        "network",
        "custom/separator",
        "cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "clock"
    ],
    "fixed-center": false,
    "battery": {
        "states": {
            "warning": 50,
            "critical": 25
        },
        "format-discharging": "{capacity}%",
        "format-charging": "{capacity}%"
    },
    "clock": {
        "format": "{:%d.%m.%y (%a) %T}",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "interval": 1,
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#ffffff'>{}</span>",
                "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
                "weekdays": "<span color='#ff00ff'>{}</span>",
                "today": "<span color='#00ff00'><b>{}</b></span>",
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    },
    "pulseaudio": {
        "format": "Vol {volume}%",
        "format-bluetooth": "{volume}% {icon}",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                ""
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol",
        "ignored-sinks": [
            "Easy Effects Sink"
        ]
    },
    "network": {
        "interval": 2,
        "format": "{ifname}",
        "format-wifi": "W",
        "format-ethernet": "E",
        "format-disconnected": "N",
        "max-length": 50
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-window-separator": ""
    },
    "hyprland/window": {
        "format": "{}",
        "rewrite": {
            "": "void"
        }
    },
    "cpu": {
        "states": {
            "warning": 50,
            "critical": 75
        },
        "format": "CPU {usage}%",
        "interval": 2
    },
    "memory": {
        "states": {
            "warning": 50,
            "critical": 75
        },
        "format": "RAM {percentage}% (SWP {swapPercentage}%)",
        "interval": 2,
        "max-length": 30
    },
    "sway/window": {
        "format": "{}",
        "rewrite": {
            "": "empty"
        }
    }
}
